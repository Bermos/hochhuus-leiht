{
  "$schema": "https://raw.githubusercontent.com/Bermos/Kitchen/main/docs/schemas/kitchen.schema.json",
  "build": {"strategy": "dockerfile"},
  "runtime": {
    "port": 8080,
    "command": ["/hochhuus", "serve"],
    "health": {"path": "/healthz"},
    "resources": {"cpu": "250m", "memory": "256Mi"},
    "security": {"runAsNonRoot": true, "runAsUser": 65532, "readOnlyRootFilesystem": true, "dropCapabilities": ["ALL"]}
  },
  "processes": [
    {"name": "migrate", "type": "task", "command": ["/hochhuus", "migrate"], "timeout": "5m"}
  ]
}
